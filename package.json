{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check:translations": "bun run scripts/checkTranslations.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "~6.0.2",
    "wrangler": "^4.130.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "i18next": "^26.4.2",
    "react-i18next": "^17.0.13"
  }
}
