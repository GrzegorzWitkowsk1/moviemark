MONGO_URI=
PORT=3000
HOST=0.0.0.0
# Exact origin (scheme + host, no trailing slash) of the web app.
# In production this must match the deployed frontend (e.g. https://moviemark.pages.dev).
CORS_ORIGIN=http://localhost:5173
# Production only: set NODE_ENV=production so the refresh cookie is sent with
# SameSite=None; Secure (required when the API and web are on different domains).
NODE_ENV=development
JWT_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Optional cap for the /auth rate limiter.
RATE_LIMIT_MAX=100
# Optional cap for the TMDB proxy rate limiter (requests per minute).
TMDB_RATE_LIMIT_MAX=30
COOKIE_NAME=refreshToken
TMDB_API_BASE=https://api.themoviedb.org/3
TMDB_TOKEN=your-tmdb-api-token
